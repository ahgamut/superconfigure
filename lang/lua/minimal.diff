diff -r --unified lua.orig/makefile lua/makefile
--- lua.orig/makefile	2026-11-15 05:46:15.000000000 +0000
+++ lua/makefile	2026-11-15 05:49:40.000000000 +0000
@@ -75,15 +75,13 @@
 # For C89, "-std=c89 -DLUA_USE_C89"
 # Note that Linux/Posix options are not compatible with C89
 # (For 32-bit, add option "-m32" to MYCFLAGS and MYLDFLAGS.)
-MYCFLAGS= $(LOCAL) -std=c99 -DLUA_USE_LINUX
+MYCFLAGS= $(LOCAL) -std=c99 -DLUA_USE_POSIX -DLUA_USE_READLINE
 MYLDFLAGS= -Wl,-E
-MYLIBS= -ldl
+MYLIBS= -ldl -lreadline -ltinfo
 
 
-CC= gcc
 # (Optionally we can use -march=native -mno-avx512f.)
 CFLAGS= -Wall -O2 $(MYCFLAGS) -fno-stack-protector -fno-common
-AR= ar rc
 RANLIB= ranlib
 RM= rm -f
 
@@ -118,7 +116,7 @@
 a:	$(ALL_A)
 
 $(CORE_T): $(CORE_O) $(AUX_O) $(LIB_O)
-	$(AR) $@ $?
+	$(AR) rc $@ $?
 	$(RANLIB) $@
 
 $(LUA_T): $(LUA_O) $(CORE_T)
